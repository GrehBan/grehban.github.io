---
import { getCollection } from "astro:content";
import SiteLayout from "../layouts/SiteLayout.astro";

const base = import.meta.env.BASE_URL;
const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("en", { year: "numeric", month: "short", day: "numeric", timeZone: "UTC" }).format(date);
const focusAreas = [
  { title: "Backend & Async", description: "Typed Python APIs, asynchronous services, and outbound HTTP integrations.", tags: ["Python 3.10+", "asyncio", "FastAPI", "Starlette", "aiohttp", "HTTPX", "Pydantic", "typing"] },
  { title: "Databases", description: "Relational, document, cache, and time-series storage with deliberate schema evolution.", tags: ["PostgreSQL", "MongoDB", "Redis", "InfluxDB", "SQL", "SQLAlchemy 2.0", "Alembic"] },
  { title: "Messaging & Distributed Systems", description: "Queues, streams, and task processing chosen for the delivery model each system needs.", tags: ["RabbitMQ", "RabbitMQ Quorum Queues", "NATS", "NATS JetStream", "Celery"] },
  { title: "Infrastructure", description: "Linux-first delivery, container orchestration, and web-server operations.", tags: ["Linux", "Docker", "Docker Swarm", "Nginx", "Apache", "Bash"] },
  { title: "Observability", description: "Metrics, traces, and logs that make distributed services easier to operate.", tags: ["Prometheus", "Grafana", "OpenTelemetry", "LGTM Stack", "Loki"] },
  { title: "Testing", description: "Fast feedback, realistic infrastructure in tests, and property-based edge-case discovery.", tags: ["Pytest", "pytest-asyncio", "Testcontainers", "Hypothesis"] },
  { title: "CI/CD", description: "Repeatable checks and delivery pipelines for Python services.", tags: ["GitHub Actions"] },
  { title: "AI & integrations", description: "Async API tooling for AI/LLM services, networking, and Telegram automation.", tags: ["AI / LLM", "API tooling", "Telegram bots"] },
];
---

<SiteLayout
  title="Max — Backend & Distributed Systems Engineer"
  description="Backend and distributed systems engineer specializing in typed, async-first Python, API tooling, messaging, data systems, infrastructure, testing, and observability."
  canonicalPath=""
>
  <main>
    <section class="site-shell hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="hero-kicker">Python 3.10+ / backend / distributed systems</p>
        <h1 id="hero-title">Hi, I’m <span>Max.</span></h1>
        <p class="hero-lede">Backend &amp; Distributed Systems Engineer specializing in typed, async-first Python.</p>
        <p class="hero-note">Seven years in Python. From API contracts to production operations.</p>
        <div class="hero-actions">
          <a class="button button-primary" href={`${base}#projects`}>Explore my work <span aria-hidden="true">↘</span></a>
          <a class="button" href="https://github.com/GrehBan" target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="hero-avatar-frame">
        <img
          class="hero-avatar"
          src="https://github.com/GrehBan.png?size=320"
          alt="Max’s GitHub profile avatar"
          width="320"
          height="320"
          onerror={`this.onerror=null;this.src='${base}avatar-fallback.svg'`}
        />
          <span class="avatar-caption">@GrehBan / GitHub</span>
      </div>
    </section>

    <hr class="rule site-shell" />

    <section class="site-shell section" id="projects" aria-labelledby="projects-title">
      <p class="section-label">projects</p>
      <div class="section-heading">
        <h2 id="projects-title">One stack, end to end.</h2>
        <p>Backend APIs through messaging, deployment, testing, and runtime visibility. These are complementary tools, not one fixed bundle used in every system.</p>
      </div>
      <div class="project-grid">
        {focusAreas.map((project, index) => (
          <article class="project-card">
            <div class="project-topline"><span class="project-index">0{index + 1} / focus</span><span>↗</span></div>
            <h3>{project.title}</h3>
            <p>{project.description}</p>
            <div class="tag-list">{project.tags.map((tag) => <span class="tag">{tag}</span>)}</div>
          </article>
        ))}
      </div>
      <p class="section-footnote">These are areas of focus, not a list of named client projects. <a class="text-link" href="https://github.com/GrehBan" target="_blank" rel="noreferrer">See my public work on GitHub ↗</a></p>
    </section>

    <hr class="rule site-shell" />

    <section class="site-shell section" id="about" aria-labelledby="about-title">
      <p class="section-label">about</p>
      <div class="about-layout">
        <div class="about-stamp" aria-label="Developer profile">
          <span class="code-line"><span class="code-value">max</span> = Engineer(</span>
          <span class="code-line">&nbsp;&nbsp;focus=<span class="code-value">"backend + distributed systems"</span>,</span>
          <span class="code-line">&nbsp;&nbsp;python=<span class="code-value">">=3.10"</span>,</span>
          <span class="code-line">&nbsp;&nbsp;concurrency=<span class="code-value">"asyncio"</span>,</span>
          <span class="code-line">&nbsp;&nbsp;style=<span class="code-value">"typed, async-first"</span>,</span>
          <span class="code-line">)</span>
        </div>
        <div class="about-copy">
          <h2 id="about-title">Practical by design.<br />Precise by default.</h2>
          <p>I’ve spent seven years in Python, working across the full backend lifecycle: typed API boundaries, async networking, persistence and migrations, distributed work, delivery, and production visibility.</p>
          <p><strong>FastAPI and Starlette with Pydantic</strong> cover HTTP services; asyncio, aiohttp, and HTTPX support async work and integrations. The data layer spans PostgreSQL, SQLAlchemy 2.0, Alembic, MongoDB, Redis, InfluxDB, and direct SQL—different tools for different data and access patterns.</p>
          <p>RabbitMQ quorum queues and NATS JetStream offer distinct messaging models; Celery handles task workflows. I choose between them based on delivery guarantees, replay needs, and operational fit—not by combining every broker by default.</p>
          <p>Docker, Docker Swarm, Nginx, Apache, Linux, Bash, and GitHub Actions take services toward production. Pytest, pytest-asyncio, Testcontainers, and Hypothesis support confidence; Prometheus, Grafana, OpenTelemetry, the LGTM stack, and Loki help make runtime behavior visible.</p>
          <div class="skill-lines" aria-label="Areas of focus">
            <span class="skill-line">Typed, async-first design</span>
            <span class="skill-line">HTTP APIs & integrations</span>
            <span class="skill-line">Data & schema evolution</span>
            <span class="skill-line">Messaging & background work</span>
            <span class="skill-line">Testing & reliability</span>
            <span class="skill-line">Production operations</span>
          </div>
        </div>
      </div>
    </section>

    <hr class="rule site-shell" />

    <section class="site-shell section" id="blog" aria-labelledby="blog-title">
      <p class="section-label">blog</p>
      <div class="section-heading">
        <h2 id="blog-title">Thinking in public.</h2>
        <p>Notes on Python, async systems, typing, and the small decisions that shape dependable tools.</p>
      </div>
      {posts.length ? (
        <div class="blog-list">
          {posts.map((post) => (
            <article class="post-row">
              <time class="post-date" datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
              <a href={`${base}blog/${post.id}/`}>
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
                <span class="post-tags">{post.data.tags.map((tag) => <span class="tag">{tag}</span>)}</span>
              </a>
              <a class="post-arrow" href={`${base}blog/${post.id}/`} aria-label={`Read ${post.data.title}`}>↗</a>
            </article>
          ))}
        </div>
      ) : (
        <div class="empty-state">New notes are being shaped. Check back soon.</div>
      )}
      <a class="text-link blog-all" href={`${base}blog/`}>Browse all posts →</a>
    </section>

    <hr class="rule site-shell" />

    <section class="site-shell section" id="contact" aria-labelledby="contact-title">
      <p class="section-label">contact</p>
      <div class="contact-layout">
        <div class="contact-intro">
          <h2 id="contact-title">Let’s talk about the tricky parts.</h2>
          <p>Have a Python API, distributed workload, or async integration to make more dependable? Send a note.</p>
          <div class="contact-links">
            <a class="contact-link" href="https://github.com/GrehBan" target="_blank" rel="noreferrer"><span>↗</span><strong>GitHub</strong> @GrehBan</a>
            <a class="contact-link" href="https://t.me/maxexban" target="_blank" rel="noreferrer"><span>↗</span><strong>Telegram</strong> @maxexban</a>
            <a class="contact-link" href="mailto:maximfeedback19@gmail.com"><span>@</span><strong>Email</strong> maximfeedback19@gmail.com</a>
          </div>
        </div>
        <form class="contact-form" action="https://formspree.io/f/your-form-id" method="POST">
          <div class="honeypot" aria-hidden="true">
            <label for="company">Leave this field empty</label>
            <input id="company" name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <div class="form-grid">
            <div class="field">
              <label for="name">Name</label>
              <input id="name" name="name" type="text" autocomplete="name" required maxlength="120" />
            </div>
            <div class="field">
              <label for="email">Email</label>
              <input id="email" name="email" type="email" autocomplete="email" required maxlength="254" />
            </div>
            <div class="field field-full">
              <label for="message">What are you working on?</label>
              <textarea id="message" name="message" required minlength="10" maxlength="5000"></textarea>
            </div>
          </div>
          <button class="button button-primary form-submit" type="submit">Send message <span aria-hidden="true">→</span></button>
          <p class="form-note">The form endpoint is a setup placeholder; direct email is available above.</p>
        </form>
      </div>
    </section>
  </main>
</SiteLayout>
