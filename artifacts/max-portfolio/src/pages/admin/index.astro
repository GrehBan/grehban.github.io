---
import SiteLayout from "../../layouts/SiteLayout.astro";

const englishPostsUrl =
  "https://github.com/GrehBan/grehban.github.io/tree/master/artifacts/max-portfolio/src/content/blog";
const russianPostsUrl = `${englishPostsUrl}/ru`;
---

<SiteLayout
  title="Blog editor — Max"
  description="Manage portfolio blog posts in the GitHub repository."
  canonicalPath="admin/"
  language="en"
  languageSwitchHref={`${import.meta.env.BASE_URL}ru/`}
  noIndex={true}
  languageAlternates={false}
>
  <main class="admin-main">
    <div class="admin-wrap">
      <header class="admin-heading">
        <p class="section-label">blog editor</p>
        <h1>Manage posts</h1>
        <p>
          Posts are Markdown files in this repository. GitHub handles your admin
          sign-in and records each change as a commit; no token or password is
          stored on this site.
        </p>
      </header>

      <section class="admin-panel">
        <h2>Edit or create a post</h2>
        <p>
          Open the right language folder while signed in to GitHub with write
          access to this repository.
        </p>
        <div class="folder-links">
          <a class="admin-button admin-button-primary" href={englishPostsUrl}>
            English posts
          </a>
          <a class="admin-button" href={russianPostsUrl}>Русские посты</a>
        </div>
        <ol>
          <li>
            To edit a post, open its Markdown file, choose <strong>Edit this file</strong>,
            and commit the change to <code>master</code>.
          </li>
          <li>
            To create one, choose <strong>Add file → Create new file</strong> in
            the folder and use a lowercase kebab-case <code>.md</code> filename.
          </li>
          <li>
            Set <code>draft: true</code> to keep a post out of the public blog,
            RSS feed, and sitemap. Set it to <code>false</code> when ready to publish.
          </li>
        </ol>
      </section>

      <section class="admin-panel template-panel">
        <h2>Frontmatter</h2>
        <p>Start a new file with this metadata, then add the post in Markdown.</p>
        <pre><code>---
title: "Post title"
description: "Short summary of the post."
pubDate: 2026-11-18
tags: ["Python", "async"]
draft: true
locale: en
---

Write the post here.</code></pre>
        <p class="admin-muted">
          English files go in <code>src/content/blog/</code>; Russian files go
          in <code>src/content/blog/ru/</code> and use <code>locale: ru</code>.
          A commit to <code>master</code> starts the GitHub Pages build.
        </p>
      </section>
    </div>
  </main>
</SiteLayout>

<style>
  .admin-main {
    min-height: calc(100dvh - 160px);
    padding-block: 68px 96px;
  }

  .admin-wrap {
    display: grid;
    width: min(840px, calc(100% - 48px));
    gap: 18px;
    margin-inline: auto;
  }

  .admin-heading {
    margin-bottom: 12px;
  }

  .admin-heading h1 {
    margin: 0;
    font-size: clamp(38px, 6vw, 58px);
    line-height: 1.05;
    letter-spacing: -.065em;
  }

  .admin-heading > p:last-child,
  .admin-panel > p {
    max-width: 680px;
    margin: 14px 0 0;
    color: var(--muted);
  }

  .admin-panel {
    padding: 24px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: color-mix(in srgb, var(--surface) 94%, transparent);
  }

  .admin-panel h2 {
    margin: 0;
    font-size: 19px;
    letter-spacing: -.035em;
  }

  .folder-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 20px;
  }

  .admin-button {
    display: inline-flex;
    min-height: 40px;
    align-items: center;
    justify-content: center;
    padding: 0 13px;
    border: 1px solid var(--border-strong);
    border-radius: 7px;
    background: var(--surface-raised);
    color: var(--text);
    font: 500 11px var(--font-mono);
    text-decoration: none;
  }

  .admin-button:hover {
    border-color: var(--accent);
    background: var(--accent-wash);
  }

  .admin-button-primary {
    border-color: var(--accent-solid);
    background: var(--accent-solid);
    color: #fff;
  }

  .admin-panel ol {
    display: grid;
    gap: 11px;
    margin: 22px 0 0;
    padding-left: 22px;
    color: var(--muted);
    line-height: 1.7;
  }

  .admin-panel strong,
  .admin-panel code {
    color: var(--text);
  }

  .admin-panel code {
    font: 12px var(--font-mono);
  }

  .template-panel pre {
    overflow-x: auto;
    margin: 18px 0 0;
    padding: 16px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg);
    color: var(--text);
    font: 12px/1.7 var(--font-mono);
  }

  .admin-muted {
    color: var(--muted);
    font-size: 13px;
    line-height: 1.7;
  }

  @media (max-width: 520px) {
    .admin-main {
      padding-block: 46px 70px;
    }

    .admin-wrap {
      width: min(100% - 36px, 600px);
    }

    .admin-panel {
      padding: 18px;
    }
  }
</style>
