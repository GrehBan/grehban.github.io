---
import { getCollection } from "astro:content";
import SiteLayout from "../layouts/SiteLayout.astro";

interface Props {
  language: "en" | "ru";
}

const { language } = Astro.props;
const isRussian = language === "ru";
const base = import.meta.env.BASE_URL;
const homePath = isRussian ? `${base}ru/` : base;
const switchPath = isRussian ? base : `${base}ru/`;
const posts = (await getCollection(
  "blog",
  ({ data }) => !data.draft && data.locale === language,
))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat(isRussian ? "ru-RU" : "en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
    timeZone: "UTC",
  }).format(date);

const copy = isRussian
  ? {
      title: "Макс — инженер по backend-разработке и распределённым системам",
      description:
        "Инженер по backend-разработке и распределённым системам. Типизированный асинхронный Python, API, брокеры сообщений, инфраструктура, тестирование и наблюдаемость.",
      kicker: "Python 3.10+ / backend / распределённые системы",
      greeting: "Привет, я",
      role: "Инженер по backend-разработке и распределённым системам, специализируюсь на типизированном асинхронном Python.",
      experience: "Семь лет с Python. От контрактов API до эксплуатации в production.",
      workButton: "Мои проекты",
      projectsLabel: "проекты",
      projectsTitle: "Один стек — от API до production.",
      projectsDescription:
        "От backend API до очередей, деплоя, тестирования и наблюдаемости. Это набор взаимодополняющих инструментов, а не фиксированная связка для каждого проекта.",
      focusWord: "направление",
      projectsNote: "Здесь перечислены направления и технологии, а не вымышленные клиентские проекты.",
      githubWork: "Посмотреть публичные репозитории на GitHub ↗",
      aboutLabel: "обо мне",
      aboutTitle: "Практичный подход.<br />Точность по умолчанию.",
      aboutIntro:
        "Семь лет работаю с Python и backend-системами на всех этапах: типизированные API, асинхронные сети, хранение данных и миграции, распределённая обработка, доставка и наблюдаемость в production.",
      aboutApi:
        "<strong>FastAPI и Starlette с Pydantic</strong> — для HTTP-сервисов; asyncio, aiohttp и HTTPX — для асинхронной логики и интеграций. В работе использую PostgreSQL, SQLAlchemy 2.0, Alembic, MongoDB, Redis, InfluxDB и SQL — разные инструменты под разные модели данных и сценарии доступа.",
      aboutMessaging:
        "RabbitMQ Quorum Queues и NATS JetStream решают разные задачи обмена сообщениями; Celery — для фоновых задач. Выбор зависит от гарантий доставки, необходимости повторного чтения событий и стоимости эксплуатации, а не от желания объединить все брокеры в одну систему.",
      aboutOperations:
        "Docker, Docker Swarm, Nginx, Apache, Linux, Bash и GitHub Actions помогают довести сервис до production. Pytest, pytest-asyncio, Testcontainers и Hypothesis повышают надёжность; Prometheus, Grafana, OpenTelemetry, LGTM Stack и Loki помогают видеть поведение системы.",
      skillsLabel: "Области экспертизы",
      skills: [
        "Типизированная асинхронная разработка",
        "HTTP API и интеграции",
        "Хранение данных и миграции",
        "Очереди и фоновые задачи",
        "Тестирование и надёжность",
        "Эксплуатация production-систем",
      ],
      blogLabel: "блог",
      blogTitle: "Заметки о системах.",
      blogDescription:
        "Python, асинхронность, типизация и инженерные решения, из которых складываются надёжные инструменты.",
      emptyBlog: "Новые заметки готовятся. Загляните позже.",
      allPosts: "Все статьи →",
      contactLabel: "контакты",
      contactTitle: "Обсудим сложные части системы.",
      contactDescription:
        "Нужно сделать надёжнее Python API, распределённую обработку или асинхронную интеграцию? Напишите.",
      formName: "Имя",
      formEmail: "Электронная почта",
      formMessage: "Над чем вы работаете?",
      formSubmit: "Отправить сообщение",
      formNote:
        "Адрес формы нужно настроить; пока можно написать напрямую на почту.",
    }
  : {
      title: "Max — Backend & Distributed Systems Engineer",
      description:
        "Backend and distributed systems engineer specializing in typed, async-first Python, API tooling, messaging, data systems, infrastructure, testing, and observability.",
      kicker: "Python 3.10+ / backend / distributed systems",
      greeting: "Hi, I’m",
      role: "Backend & Distributed Systems Engineer specializing in typed, async-first Python.",
      experience: "Seven years in Python. From API contracts to production operations.",
      workButton: "Explore my work",
      projectsLabel: "projects",
      projectsTitle: "One stack, end to end.",
      projectsDescription:
        "Backend APIs through messaging, deployment, testing, and runtime visibility. These are complementary tools, not one fixed bundle used in every system.",
      focusWord: "focus",
      projectsNote:
        "These are areas of focus, not a list of named client projects.",
      githubWork: "See my public work on GitHub ↗",
      aboutLabel: "about",
      aboutTitle: "Practical by design.<br />Precise by default.",
      aboutIntro:
        "Seven years in Python, working across the full backend lifecycle: typed API boundaries, async networking, persistence and migrations, distributed work, delivery, and production visibility.",
      aboutApi:
        "<strong>FastAPI and Starlette with Pydantic</strong> cover HTTP services; asyncio, aiohttp, and HTTPX support async work and integrations. The data layer spans PostgreSQL, SQLAlchemy 2.0, Alembic, MongoDB, Redis, InfluxDB, and direct SQL—different tools for different data and access patterns.",
      aboutMessaging:
        "RabbitMQ quorum queues and NATS JetStream offer distinct messaging models; Celery handles task workflows. I choose between them based on delivery guarantees, replay needs, and operational fit—not by combining every broker by default.",
      aboutOperations:
        "Docker, Docker Swarm, Nginx, Apache, Linux, Bash, and GitHub Actions take services toward production. Pytest, pytest-asyncio, Testcontainers, and Hypothesis support confidence; Prometheus, Grafana, OpenTelemetry, the LGTM stack, and Loki help make runtime behavior visible.",
      skillsLabel: "Areas of focus",
      skills: [
        "Typed, async-first design",
        "HTTP APIs & integrations",
        "Data & schema evolution",
        "Messaging & background work",
        "Testing & reliability",
        "Production operations",
      ],
      blogLabel: "blog",
      blogTitle: "Thinking in public.",
      blogDescription:
        "Notes on Python, async systems, typing, and the small decisions that shape dependable tools.",
      emptyBlog: "New notes are being shaped. Check back soon.",
      allPosts: "Browse all posts →",
      contactLabel: "contact",
      contactTitle: "Let’s talk about the tricky parts.",
      contactDescription:
        "Have a Python API, distributed workload, or async integration to make more dependable? Send a note.",
      formName: "Name",
      formEmail: "Email",
      formMessage: "What are you working on?",
      formSubmit: "Send message",
      formNote:
        "The form endpoint is a setup placeholder; direct email is available above.",
    };

const focusAreas = isRussian
  ? [
      { title: "Backend и асинхронность", description: "Типизированные API на Python, асинхронные сервисы и HTTP-интеграции.", tags: ["Python 3.10+", "asyncio", "FastAPI", "Starlette", "aiohttp", "HTTPX", "Pydantic", "typing"] },
      { title: "Базы данных", description: "Реляционное, документное, кэшируемое и временное хранение с управляемой эволюцией схем.", tags: ["PostgreSQL", "MongoDB", "Redis", "InfluxDB", "SQL", "SQLAlchemy 2.0", "Alembic"] },
      { title: "Сообщения и распределённые системы", description: "Очереди, потоки событий и фоновые задачи под нужную модель доставки.", tags: ["RabbitMQ", "RabbitMQ Quorum Queues", "NATS", "NATS JetStream", "Celery"] },
      { title: "Инфраструктура", description: "Linux, контейнеризация, оркестрация и эксплуатация веб-серверов.", tags: ["Linux", "Docker", "Docker Swarm", "Nginx", "Apache", "Bash"] },
      { title: "Наблюдаемость", description: "Метрики, трассировки и логи для эксплуатации распределённых сервисов.", tags: ["Prometheus", "Grafana", "OpenTelemetry", "LGTM Stack", "Loki"] },
      { title: "Тестирование", description: "Быстрая обратная связь, реалистичная инфраструктура в тестах и проверка граничных случаев.", tags: ["Pytest", "pytest-asyncio", "Testcontainers", "Hypothesis"] },
      { title: "CI/CD", description: "Повторяемые проверки и конвейеры доставки Python-сервисов.", tags: ["GitHub Actions"] },
      { title: "AI и интеграции", description: "Асинхронные API-интеграции с AI/LLM-сервисами и Telegram-ботами.", tags: ["AI / LLM", "API tooling", "Telegram bots"] },
    ]
  : [
      { title: "Backend & Async", description: "Typed Python APIs, asynchronous services, and outbound HTTP integrations.", tags: ["Python 3.10+", "asyncio", "FastAPI", "Starlette", "aiohttp", "HTTPX", "Pydantic", "typing"] },
      { title: "Databases", description: "Relational, document, cache, and time-series storage with deliberate schema evolution.", tags: ["PostgreSQL", "MongoDB", "Redis", "InfluxDB", "SQL", "SQLAlchemy 2.0", "Alembic"] },
      { title: "Messaging & Distributed Systems", description: "Queues, streams, and task processing chosen for the delivery model each system needs.", tags: ["RabbitMQ", "RabbitMQ Quorum Queues", "NATS", "NATS JetStream", "Celery"] },
      { title: "Infrastructure", description: "Linux-first delivery, container orchestration, and web-server operations.", tags: ["Linux", "Docker", "Docker Swarm", "Nginx", "Apache", "Bash"] },
      { title: "Observability", description: "Metrics, traces, and logs that make distributed services easier to operate.", tags: ["Prometheus", "Grafana", "OpenTelemetry", "LGTM Stack", "Loki"] },
      { title: "Testing", description: "Fast feedback, realistic infrastructure in tests, and property-based edge-case discovery.", tags: ["Pytest", "pytest-asyncio", "Testcontainers", "Hypothesis"] },
      { title: "CI/CD", description: "Repeatable checks and delivery pipelines for Python services.", tags: ["GitHub Actions"] },
      { title: "AI & integrations", description: "Async API tooling for AI/LLM services, networking, and Telegram automation.", tags: ["AI / LLM", "API tooling", "Telegram bots"] },
    ];
---

<SiteLayout
  title={copy.title}
  description={copy.description}
  canonicalPath={isRussian ? "ru/" : ""}
  language={language}
  languageSwitchHref={switchPath}
>
  <main>
    <section class="site-shell hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="hero-kicker">{copy.kicker}</p>
        <h1 id="hero-title">{copy.greeting} <span>{isRussian ? "Макс." : "Max."}</span></h1>
        <p class="hero-lede">{copy.role}</p>
        <p class="hero-note">{copy.experience}</p>
        <div class="hero-actions">
          <a class="button button-primary" href={`${homePath}#projects`}>{copy.workButton} <span aria-hidden="true">↘</span></a>
          <a class="button" href="https://github.com/GrehBan" target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="hero-avatar-frame">
        <img
          class="hero-avatar"
          src="https://github.com/GrehBan.png?size=320"
          alt={isRussian ? "Аватар Макса в GitHub" : "Max’s GitHub profile avatar"}
          width="320"
          height="320"
          onerror={`this.onerror=null;this.src='${base}avatar-fallback.svg'`}
        />
        <span class="avatar-caption">@GrehBan / GitHub</span>
      </div>
    </section>

    <hr class="rule site-shell" />

    <section class="site-shell section" id="projects" aria-labelledby="projects-title">
      <p class="section-label">{copy.projectsLabel}</p>
      <div class="section-heading">
        <h2 id="projects-title">{copy.projectsTitle}</h2>
        <p>{copy.projectsDescription}</p>
      </div>
      <div class="project-grid">
        {focusAreas.map((project, index) => (
          <article class="project-card">
            <div class="project-topline"><span class="project-index">0{index + 1} / {copy.focusWord}</span><span>↗</span></div>
            <h3>{project.title}</h3>
            <p>{project.description}</p>
            <div class="tag-list">{project.tags.map((tag) => <span class="tag">{tag}</span>)}</div>
          </article>
        ))}
      </div>
      <p class="section-footnote">{copy.projectsNote} <a class="text-link" href="https://github.com/GrehBan" target="_blank" rel="noreferrer">{copy.githubWork}</a></p>
    </section>

    <hr class="rule site-shell" />

    <section class="site-shell section" id="about" aria-labelledby="about-title">
      <p class="section-label">{copy.aboutLabel}</p>
      <div class="about-layout">
        <div class="about-stamp" aria-label={isRussian ? "Профиль инженера" : "Engineer profile"}>
          <span class="code-line"><span class="code-value">max</span> = Engineer(</span>
          <span class="code-line">&nbsp;&nbsp;focus=<span class="code-value">"backend + distributed systems"</span>,</span>
          <span class="code-line">&nbsp;&nbsp;python=<span class="code-value">"&gt;=3.10"</span>,</span>
          <span class="code-line">&nbsp;&nbsp;concurrency=<span class="code-value">"asyncio"</span>,</span>
          <span class="code-line">&nbsp;&nbsp;style=<span class="code-value">"typed, async-first"</span>,</span>
          <span class="code-line">)</span>
        </div>
        <div class="about-copy">
          <h2 set:html={copy.aboutTitle} />
          <p>{copy.aboutIntro}</p>
          <p set:html={copy.aboutApi} />
          <p>{copy.aboutMessaging}</p>
          <p>{copy.aboutOperations}</p>
          <div class="skill-lines" aria-label={copy.skillsLabel}>
            {copy.skills.map((skill) => <span class="skill-line">{skill}</span>)}
          </div>
        </div>
      </div>
    </section>

    <hr class="rule site-shell" />

    <section class="site-shell section" id="blog" aria-labelledby="blog-title">
      <p class="section-label">{copy.blogLabel}</p>
      <div class="section-heading">
        <h2 id="blog-title">{copy.blogTitle}</h2>
        <p>{copy.blogDescription}</p>
      </div>
      {posts.length ? (
        <div class="blog-list">
          {posts.map((post) => {
            const slug = post.id.replace(/^ru\//, "");
            const postHref = `${homePath}blog/${slug}/`;
            return (
              <article class="post-row">
                <time class="post-date" datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                <a href={postHref}>
                  <h3>{post.data.title}</h3>
                  <p>{post.data.description}</p>
                  <span class="post-tags">{post.data.tags.map((tag) => <span class="tag">{tag}</span>)}</span>
                </a>
                <a class="post-arrow" href={postHref} aria-label={`${isRussian ? "Читать" : "Read"} ${post.data.title}`}>↗</a>
              </article>
            );
          })}
        </div>
      ) : (
        <div class="empty-state">{copy.emptyBlog}</div>
      )}
      <a class="text-link blog-all" href={`${homePath}blog/`}>{copy.allPosts}</a>
    </section>

    <hr class="rule site-shell" />

    <section class="site-shell section" id="contact" aria-labelledby="contact-title">
      <p class="section-label">{copy.contactLabel}</p>
      <div class="contact-layout">
        <div class="contact-intro">
          <h2 id="contact-title">{copy.contactTitle}</h2>
          <p>{copy.contactDescription}</p>
          <div class="contact-links">
            <a class="contact-link" href="https://github.com/GrehBan" target="_blank" rel="noreferrer"><span>↗</span><strong>GitHub</strong> @GrehBan</a>
            <a class="contact-link" href="https://t.me/maxexban" target="_blank" rel="noreferrer"><span>↗</span><strong>Telegram</strong> @maxexban</a>
            <a class="contact-link" href="mailto:maximfeedback19@gmail.com"><span>@</span><strong>Email</strong> maximfeedback19@gmail.com</a>
          </div>
        </div>
        <form class="contact-form" action="https://formspree.io/f/your-form-id" method="POST">
          <div class="honeypot" aria-hidden="true">
            <label for={`company-${language}`}>{isRussian ? "Оставьте это поле пустым" : "Leave this field empty"}</label>
            <input id={`company-${language}`} name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <div class="form-grid">
            <div class="field">
              <label for={`name-${language}`}>{copy.formName}</label>
              <input id={`name-${language}`} name="name" type="text" autocomplete="name" required maxlength="120" />
            </div>
            <div class="field">
              <label for={`email-${language}`}>{copy.formEmail}</label>
              <input id={`email-${language}`} name="email" type="email" autocomplete="email" required maxlength="254" />
            </div>
            <div class="field field-full">
              <label for={`message-${language}`}>{copy.formMessage}</label>
              <textarea id={`message-${language}`} name="message" required minlength="10" maxlength="5000"></textarea>
            </div>
          </div>
          <button class="button button-primary form-submit" type="submit">{copy.formSubmit} <span aria-hidden="true">→</span></button>
          <p class="form-note">{copy.formNote}</p>
        </form>
      </div>
    </section>
  </main>
</SiteLayout>
